{
  "name": "Automated Faceless YouTube Shorts Generator",
  "nodes": [
    {
      "parameters": {},
      "id": "0b4da250-3aca-48c4-8fed-b027666a0e43",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {}
          ]
        }
      },
      "id": "6b700ac2-60d3-4ba8-a3a5-b5f24beca89c",
      "name": "Daily Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "values": {
          "number": [
            {
              "name": "duration_seconds",
              "value": 15
            }
          ],
          "string": [
            {
              "name": "topic",
              "value": "an unbelievable psychological or historical fact"
            }
          ]
        },
        "options": {}
      },
      "id": "9d4b2535-b136-41e5-a13d-f0c8ae7e7ce8",
      "name": "Set Video Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        224,
        80
      ],
      "retryOnFail": true,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent?key=YOUR_GEMINI_API_KEY",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"={{ 'Generate a viral ' + ($json.duration_seconds || 15) + '-second YouTube Short about ' + ($json.topic || 'an unbelievable psychological or historical fact') + '. Rules:\\n- Target duration: exactly ' + ($json.duration_seconds || 15) + ' seconds.\\n- Voiceover script must be exactly ' + Math.round(($json.duration_seconds || 15) * 2.2) + ' words.\\n- Exactly ' + (($json.duration_seconds || 15) <= 20 ? 2 : 3) + ' visual scene descriptions for image generation.\\nRespond ONLY in valid JSON with keys: title, description, script, scenes (array of visual image prompts). No markdown ticks, just raw JSON.' }}\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"temperature\": 0.7\n  }\n}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "id": "3315f8c0-952f-412e-bf67-4a038ac985cc",
      "name": "Generate Script & Prompts (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const responseText = $input.first().json.candidates[0].content.parts[0].text;\nlet cleanText = responseText.trim();\nif (cleanText.startsWith('```json')) {\n  cleanText = cleanText.replace(/^```json/, '').replace(/```$/, '').trim();\n} else if (cleanText.startsWith('```')) {\n  cleanText = cleanText.replace(/^```/, '').replace(/```$/, '').trim();\n}\n\n// Validate JSON\nJSON.parse(cleanText);\n\n// Base64 encode without Monaco linter warnings\nconst b64 = btoa(unescape(encodeURIComponent(cleanText)));\nreturn [{ json: { payload_b64: b64 } }];"
      },
      "id": "b07bc90a-abe7-4e07-897d-f69e0c0f5adb",
      "name": "Format JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        80
      ]
    },
    {
      "parameters": {
        "command": "=echo \"{{ $json.payload_b64 }}\" | base64 -d > /tmp/input.json && node -e \"const fs = require('fs'); process.argv[2] = fs.readFileSync('/tmp/input.json', 'utf8'); require('/home/node/generate_assets.js');\""
      },
      "id": "82b8b146-b789-408c-8f10-79d64ddc12af",
      "name": "Generate Audio & Video Assets",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        880,
        80
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "/tmp/final_short.mp4",
        "options": {}
      },
      "id": "62e86d5b-1d28-4dfc-bced-ab1dee0f5f60",
      "name": "Download Video File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1104,
        80
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ JSON.parse($('Generate Audio & Video Assets').json.stdout).title }}",
        "options": {}
      },
      "id": "ac6470b2-7504-4f59-84ad-955b67d53a29",
      "name": "Upload to YouTube (Optional)",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        1328,
        80
      ],
      "disabled": true
    }
  ],
